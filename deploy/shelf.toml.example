# The operator's file for this instance (mounted into the containers). See docs: Configuration.
#
# "local":  no public address; waiting work polls GitHub often.
# "server": GitHub webhooks wake the work; the poll is a slow safety net. Use it when PUBLIC_URL is reachable by GitHub.
mode = "server"

[access]
# Who may sign in. Closed by default: with all three lists empty NOBODY can sign in. Name yourself, or nobody (you included) gets in.
# Every name is in quotes, separated by commas: users = ["alice", "bob"]
orgs   = []             # e.g. ["acme"]: members of these organisations
users  = []             # e.g. ["alice", "bob"]
admins = []             # e.g. ["alice"]: may sign in and may decide at any gate

# Which catalog skills each agent role loads (the sources are declared in config/catalog.toml, see catalog.toml.example).
# A role with no entry gets no catalog skills. Names are the `name` of a skills source; an unknown name is skipped with a
# warning in the worker's log. Edits apply without a restart. Plugin sources and [[hook]] entries ignore this: every agent gets them.
# Roles: intake, spec_critic, architect, design_reviewer, planner, implementer, code_reviewer, titler.
#
# [roles.planner]
# use = ["superpowers"]
#
# [roles.implementer]
# use = ["superpowers", "caveman"]
#
# [roles.design_reviewer]
# use = ["gdpr"]
#
# [roles.code_reviewer]
# use = ["superpowers", "gdpr"]
#
# [roles.architect]
# use = ["ui-ux-pro-max"]
