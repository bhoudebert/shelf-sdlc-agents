# Copy to deploy/.env and fill in. This file is read by Docker Compose; never commit the copy.

# --- The instance -------------------------------------------------------------------------------------------------
# The address people (and GitHub) reach this instance at, with no trailing slash. HTTPS in production.
PUBLIC_URL=https://shelf.example.org
# Port the web service is published on, on this host. Put your TLS proxy in front of it.
WEB_PORT=8080
# Signs the session cookies. Generate one:  openssl rand -hex 32
SESSION_SECRET=

# --- The GitHub App -----------------------------------------------------------------------------------------------
# Leave all of these EMPTY on the first start: the web service then offers a one-click registration at PUBLIC_URL and
# shows you exactly what to paste here. Then restart:  docker compose -f deploy/compose.yml --env-file deploy/.env up -d
# If you created the App by hand instead, every value is on the App's settings page (Settings, Developer settings,
# GitHub Apps, Edit):
#   ID            top of the page, "App ID", a number
#   SLUG          the name in the App's public link, github.com/apps/<slug>
#   CLIENT_ID     just under the App ID, starts with Iv (not the App ID)
#   CLIENT_SECRET "Client secrets", Generate a new client secret (shown once)
#   WEBHOOK_SECRET the long random string you typed in the webhook secret field
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The private key, on one line with \n for line breaks (the registration page prints it that way)...
GITHUB_APP_PRIVATE_KEY=
# The easy way to make that line: the setup page has a converter (choose the .pem, copy the result).
# ...or a path to the PEM file inside the container, if you mount it:
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# --- The agents' model --------------------------------------------------------------------------------------------
# Pick ONE way to give the agents a model.
# 1. An Anthropic API key:
ANTHROPIC_API_KEY=
# 2. A Claude subscription token (run `claude setup-token` on a machine where you are logged in):
# CLAUDE_CODE_OAUTH_TOKEN=
# 3. An Anthropic-compatible gateway (LiteLLM, or a local model server) instead of Anthropic:
# ANTHROPIC_BASE_URL=http://gateway:4000
# ANTHROPIC_AUTH_TOKEN=

# Optional: force a model, and bound what one step may spend.
# SHELF_MODEL=
SHELF_MAX_TURNS=40
# SHELF_MAX_BUDGET_USD=2

# --- Temporal -----------------------------------------------------------------------------------------------------
# The bundled Temporal needs nothing. To use your own cluster, set the address (and delete the temporal service):
# TEMPORAL_ADDRESS=temporal.example.org:7233
# TEMPORAL_NAMESPACE=default
