# --- Spec review (docs/EVOLVING.md): optional, local, free. Without a model only the deterministic checks run. ---

# Model of the spec review through Ollama (pre-push hook, node scripts/spec-review.ts --provider ollama)
# SPEC_REVIEW_MODEL=gemma4:12b

# Where Ollama answers
# OLLAMA_HOST=http://127.0.0.1:11434

# An OpenAI-compatible server instead of Ollama (LiteLLM, vLLM...): the API root with /v1, the model name it serves
# SPEC_REVIEW_PROVIDER=openai
# SPEC_REVIEW_BASE_URL=http://localhost:4000/v1
# SPEC_REVIEW_API_KEY=
# Fields added to every request, as a JSON object (e.g. switching a thinking model off)
# SPEC_REVIEW_EXTRA_BODY={"think":false}

# Longest answer asked of an OpenAI-compatible server, in tokens (a model that loops stops here)
# SPEC_REVIEW_MAX_TOKENS=4096

# Time allowed for one answer, in milliseconds
# SPEC_REVIEW_TIMEOUT_MS=300000
