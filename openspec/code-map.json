{
  "$comment": "Which code and tests belong to which capability. Read by scripts/spec-review.ts to find the requirements a change concerns. A file missing here is a warning, not a failure. Globs: * stays in a folder, ** crosses folders.",
  "capabilities": {
    "pipeline": {
      "code": [
        "src/shelf/domain/pipeline.py",
        "src/shelf/domain/policy.py"
      ],
      "tests": [
        "tests/domain/test_pipeline.py",
        "tests/domain/test_policy.py"
      ]
    },
    "work-item": {
      "code": [
        "src/shelf/domain/work.py"
      ],
      "tests": [
        "tests/domain/test_work.py"
      ]
    },
    "access": {
      "code": [
        "src/shelf/domain/access.py",
        "src/shelf/domain/config.py",
        "src/shelf/application/sign_in.py"
      ],
      "tests": [
        "tests/domain/test_access_and_roles.py",
        "tests/application/test_sign_in.py"
      ]
    },
    "work-requests": {
      "code": [
        "src/shelf/application/work.py",
        "src/shelf/application/errors.py",
        "src/shelf/domain/model.py",
        "src/shelf/ports/forge.py",
        "src/shelf/ports/runner.py",
        "src/shelf/ports/configs.py"
      ],
      "tests": [
        "tests/application/test_work.py",
        "tests/fakes.py"
      ]
    },
    "durable-workflow": {
      "code": [
        "src/shelf/adapters/temporal/*.py"
      ],
      "tests": [
        "tests/adapters/temporal/*.py",
        "tests/domain/test_polling.py",
        "tests/adapters/temporal/test_runner.py"
      ]
    },
    "github-app": {
      "code": [
        "src/shelf/adapters/github_app/*.py"
      ],
      "tests": [
        "tests/adapters/github_app/*.py"
      ]
    },
    "configuration": {
      "code": [
        "src/shelf/adapters/config/*.py",
        "src/shelf/domain/operator.py",
        "src/shelf/domain/polling.py"
      ],
      "tests": [
        "tests/adapters/config/*.py",
        "tests/domain/test_polling.py"
      ]
    },
    "pull-requests": {
      "code": [
        "src/shelf/adapters/github_app/pulls.py",
        "src/shelf/domain/commands.py"
      ],
      "tests": [
        "tests/adapters/github_app/test_pulls.py",
        "tests/domain/test_commands.py"
      ]
    },
    "steps": {
      "code": [
        "src/shelf/application/steps.py",
        "src/shelf/domain/roles.py",
        "src/shelf/domain/verdict.py",
        "src/shelf/adapters/git/*.py",
        "src/shelf/adapters/claude_agent/*.py",
        "src/shelf/ports/agents.py",
        "src/shelf/ports/workspace.py",
        "src/shelf/prompts/*.md",
        "src/shelf/ports/steps.py"
      ],
      "tests": [
        "tests/application/test_steps.py",
        "tests/domain/test_roles_and_verdict.py",
        "tests/adapters/git/*.py",
        "tests/adapters/claude_agent/*.py"
      ]
    }
  }
}
