{
  "$comment": "Which code and tests belong to which capability. Read by scripts/spec-review.ts to find the requirements a change concerns. A file missing here is a warning, not a failure. Globs: * stays in a folder, ** crosses folders.",
  "capabilities": {
    "pipeline": {
      "code": [
        "src/shelf/domain/pipeline.py",
        "src/shelf/domain/policy.py"
      ],
      "tests": [
        "tests/domain/test_pipeline.py",
        "tests/domain/test_policy.py"
      ]
    },
    "work-item": {
      "code": [
        "src/shelf/domain/work.py"
      ],
      "tests": [
        "tests/domain/test_work.py"
      ]
    },
    "access": {
      "code": [
        "src/shelf/domain/access.py",
        "src/shelf/domain/config.py",
        "src/shelf/application/sign_in.py"
      ],
      "tests": [
        "tests/domain/test_access_and_roles.py",
        "tests/application/test_sign_in.py"
      ]
    },
    "work-requests": {
      "code": [
        "src/shelf/application/work.py",
        "src/shelf/application/errors.py",
        "src/shelf/domain/model.py",
        "src/shelf/ports/*.py"
      ],
      "tests": [
        "tests/application/test_work.py",
        "tests/fakes.py"
      ]
    }
  }
}
