#!/bin/sh
# The command of a step that has a Docker daemon of its own (decision 0020), given the step's own command: `shelf-step <task>`
# for an agent, `shelf-check <task>` for a repository's check.
#
# The runner starts this as root, in the step's own kernel (the operator's runtime keeps that away from the host). It
# starts the daemon, waits until it answers, and then runs the step itself as the step's user, who may use the daemon's
# socket and nothing else of root's. Everything the daemon starts lives in this container and goes with it.
set -eu

# A container gets two things the daemon needs read-only: the cgroup filesystem, where it makes a cgroup for everything it
# starts, and /proc/sys, where it sets ip_forward. This step is root with SYS_ADMIN in its own kernel, so it can make them
# writable; where it cannot, the daemon's own message says which one below.
mount -o remount,rw /sys/fs/cgroup > /dev/null 2>&1 || true
mount -o remount,bind,rw /proc/sys > /dev/null 2>&1 || mount -o remount,rw /proc/sys > /dev/null 2>&1 || true

# On a user-defined network Docker names its embedded resolver (127.0.0.11) in resolv.conf. It lives in the host's network
# namespace, so a virtual machine cannot reach it and no name resolves (EAI_AGAIN). The runner gives this step the operator's
# resolvers; the daemon's containers inherit this file. Only addresses are written. Setting them must never stop the step: in a
# guest the file Docker places can be read-only, so a file in /run is mounted over it, and only if that is refused is the file
# written; if nothing works the reason is said and the step goes on (its first name lookup then fails, and says so).
resolv="${SHELF_RESOLV_CONF:-/etc/resolv.conf}"
resolv_new="${SHELF_RESOLV_NEW:-/run/shelf-resolv.conf}"
if [ -n "${SHELF_STEP_DNS:-}" ]; then
  case "$SHELF_STEP_DNS" in
    *[!0-9A-Fa-f:.,]*) echo "shelf-step-docker: SHELF_STEP_DNS is not a list of addresses: $resolv left as it is" >&2 ;;
    *)
      nameservers=$(for nameserver in $(printf '%s' "$SHELF_STEP_DNS" | tr ',' ' '); do printf 'nameserver %s\n' "$nameserver"; done)
      if printf '%s\n' "$nameservers" 2> /dev/null > "$resolv_new" && mount --bind "$resolv_new" "$resolv" > /dev/null 2>&1; then
        :
      elif printf '%s\n' "$nameservers" 2> /dev/null > "$resolv"; then
        :
      else
        echo "shelf-step-docker: could not set the resolvers: $resolv is not writable and could not be replaced, so names may not resolve" >&2
      fi
      ;;
  esac
fi

# The daemon's own output must not reach the step's output: the runner reads that as the step's lines.
log="${SHELF_DOCKERD_LOG:-/run/dockerd.log}"
dockerd --host=unix:///var/run/docker.sock --group=shelf > "$log" 2>&1 &

waited=0
until docker info > /dev/null 2>&1; do
  waited=$((waited + 1))
  if [ "$waited" -ge "${SHELF_DOCKERD_WAIT:-60}" ]; then
    echo "the Docker daemon of this step did not start in ${SHELF_DOCKERD_WAIT:-60} s:" >&2
    tail -n 20 "$log" >&2
    exit 1
  fi
  sleep 1
done

# The container is not marked no-new-privileges (every container the daemon starts would inherit it), so the step's own
# command takes it here: the agent keeps the protection.
exec setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs "$@"
